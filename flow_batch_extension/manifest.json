{
  "manifest_version": 3,
  "name": "Flow 批量生成与自动下载助手",
  "version": "1.2.4",
  "description": "针对 Google Labs Flow 平台的批量视频生成与自动化状态监测、自动下载工具。",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*",
    "https://*.googleusercontent.com/*",
    "https://*.googleapis.com/*",
    "https://*.googlevideo.com/*",
    "https://flow-content.google/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://flow.google.com/*",
        "*://*.flow.google.com/*",
        "*://labs.google/*",
        "*://*.labs.google/*"
      ],
      "css": [
        "injects/ui.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://flow.google.com/*",
        "*://*.flow.google.com/*",
        "*://labs.google/*",
        "*://*.labs.google/*"
      ],
      "js": [
        "injects/flow-proxy.js",
        "injects/ui.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://flow.google.com/*",
        "*://*.flow.google.com/*",
        "*://labs.google/*",
        "*://*.labs.google/*"
      ],
      "js": [
        "content-isolated.js"
      ],
      "run_at": "document_end",
      "world": "ISOLATED",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Flow 批量助手"
  }
}
